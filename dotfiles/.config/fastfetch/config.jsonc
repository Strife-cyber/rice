{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "auto", "source": "linuxmint_small", "padding": { "top": 1, "right": 3 }, "color": { "1": "green", "2": "white" } },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta" },
    "key": { "width": 6 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────────" },
    { "type": "os",       "key": " 󰣭", "keyColor": "green" },
    { "type": "kernel",   "key": " ", "keyColor": "green" },
    { "type": "uptime",   "key": " 󰅐", "keyColor": "green" },
    { "type": "packages", "key": " 󰏖", "keyColor": "green" },
    { "type": "shell",    "key": " ", "keyColor": "yellow" },
    { "type": "terminal", "key": " ", "keyColor": "yellow" },
    { "type": "de",       "key": " 󰧨", "keyColor": "yellow" },
    { "type": "cpu",      "key": " ", "keyColor": "blue", "format": "{name} ({cores-logical})" },
    { "type": "gpu",      "key": " 󰢮", "keyColor": "blue" },
    { "type": "memory",   "key": " ", "keyColor": "blue" },
    { "type": "disk",     "key": " 󰋊", "keyColor": "blue", "folders": "/" },
    { "type": "battery",  "key": " ", "keyColor": "magenta" },
    { "type": "custom", "format": "\u001b[90m────────────────────────────────" },
    { "type": "colors", "symbol": "circle" }
  ]
}
